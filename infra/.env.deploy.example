# Copy to infra/.env.deploy and source before ./infra/deploy.sh
#   set -a && source infra/.env.deploy && set +a && ./infra/deploy.sh

AWS_REGION=eu-west-1
STACK_NAME=omniparse-idp
PROJECT_NAME=omniparse-idp

# Company VPC (My-VPC01) — defaults match infra/deploy.sh
VPC_ID=vpc-01cdd75a59e8dafbb
PUBLIC_SUBNET_1=subnet-02b5205b86acb4736
PUBLIC_SUBNET_2=subnet-0fbbead678ee09529
PRIVATE_SUBNET_1=subnet-032aa6bf16272b410
PRIVATE_SUBNET_2=subnet-04a7ee472cd672864

# Optional — UI can still paste a Gemini key. Prefer setting this for server-side default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional overrides
# IMAGE_TAG=manual-1
# Container sizing is in CloudFormation parameters (defaults: 2 vCPU / 4 GB).
