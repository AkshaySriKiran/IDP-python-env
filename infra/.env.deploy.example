# Copy to infra/.env.deploy and source before ./infra/deploy.sh
#   set -a && source infra/.env.deploy && set +a && ./infra/deploy.sh

AWS_REGION=us-east-1
STACK_NAME=omniparse-idp
PROJECT_NAME=omniparse-idp

# Optional — UI can still paste a Gemini key. Prefer setting this for server-side default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional overrides
# IMAGE_TAG=manual-1
# Container sizing is in CloudFormation parameters (defaults: 2 vCPU / 4 GB).
