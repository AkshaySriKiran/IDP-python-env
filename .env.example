# ==============================================================================
# OmniParse IDP Environment Configuration Template
# Copy this file to .env and configure with your specific environment values.
# NEVER COMMIT YOUR .env FILE TO VERSION CONTROL.
# ==============================================================================

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8001
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ENVIRONMENT=development

# Authentication & Security
AUTH_REQUIRED=false
JWT_SECRET=                       # Auto-generated if left empty
JWT_EXPIRE_HOURS=12
GLOBAL_ADMIN_EMAIL=admin@omniparse.local
GLOBAL_ADMIN_PASSWORD=            # Minimum 12 characters; required when AUTH_REQUIRED=true

# AI Engine Configurations
# Gemini Cloud API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Ollama Local API
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava
# Comma-separated allowlist of allowed Ollama hosts (prevents SSRF)
ALLOWED_OLLAMA_HOSTS=localhost,127.0.0.1,host.docker.internal

# Azure AD / Microsoft Graph / SharePoint Integration (Optional)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
SSO_REDIRECT_URI=http://localhost:8001/api/auth/sso/callback
UI_BASE_URL=http://localhost:8000

# Microsoft Fabric / Azure SQL Data Warehouse Integration (Optional)
SQL_SERVER=
SQL_DATABASE=
SQL_PORT=1433
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_AUTHENTICATION=ActiveDirectoryServicePrincipal
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no
