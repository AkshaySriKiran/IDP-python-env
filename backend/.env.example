# Optional defaults (UI can still pass keys per request)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000
API_HOST=127.0.0.1
API_PORT=8001

# Azure service principal for SharePoint Graph + Fabric (never commit real values)
# App registration in Azure is named IDP_* (not "OmniParse"); use tenant/client id/secret from that app.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
# Users extract only from this SharePoint library (no local PC file upload).
FABRIC_SQL_SERVER=
FABRIC_SQL_DATABASE=

# Fabric SQL via ODBC (same pattern as the other deployed IDP app).
# When SQL_USE_API_APP_CREDENTIALS=true, UID/PWD = AZURE_CLIENT_ID / AZURE_CLIENT_SECRET.
SQL_SERVER=
SQL_DATABASE=
SQL_USERNAME=
SQL_PASSWORD=
SQL_USE_API_APP_CREDENTIALS=true
SQL_PORT=1433
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_AUTHENTICATION=ActiveDirectoryServicePrincipal
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no
